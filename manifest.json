{
  "manifest_version": 3,
  "name": "Page Snapshot",
  "version": "0.1.0",
  "description": "Save the active tab DOM as a single local HTML snapshot.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "page-snapshot@neojay.local",
      "strict_min_version": "115.0"
    }
  }
}
